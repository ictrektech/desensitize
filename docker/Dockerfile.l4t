FROM dustynv/pytorch:2.7-r36.4.0-cu128-24.04

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt ./
# Same Jetson ORT source as modules/emb_server/Dockerfile_l4t.
RUN pip3 install --no-cache-dir -r requirements.txt \
      --index-url https://mirrors.aliyun.com/pypi/simple --trusted-host mirrors.aliyun.com \
    && pip3 install --no-cache-dir onnxruntime-gpu \
      --index-url https://pypi.jetson-ai-lab.io/jp6/cu129/+simple --trusted-host pypi.jetson-ai-lab.io
COPY app ./app
EXPOSE 5000
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5000"]
